# flowrite — TESTING environment template.
# Copy to .env.testing and fill in ANTHROPIC_API_KEY.
# Select with: flue run <resource> --env .env.testing --input '{...}'
ANTHROPIC_API_KEY=

# Cheap, fast models and low effort — keeps test runs inexpensive.
WRITER_MODEL=anthropic/claude-haiku-4-5
WRITER_EFFORT=low

RESEARCHER_MODEL=anthropic/claude-haiku-4-5
RESEARCHER_EFFORT=low

EXAMPLES_MODEL=anthropic/claude-haiku-4-5
EXAMPLES_EFFORT=low

INTEGRATOR_MODEL=anthropic/claude-haiku-4-5
INTEGRATOR_EFFORT=low

DESIGNER_MODEL=anthropic/claude-haiku-4-5
DESIGNER_EFFORT=low

# reviewer tier also covers style_checker and review_resolver
REVIEWER_MODEL=anthropic/claude-haiku-4-5
REVIEWER_EFFORT=low

# Default target for test runs: the bundled tinyoptics fixture.
REPO_PATH=/home/milad/sources/zio-skills/flowrite/fixtures/tinyoptics
